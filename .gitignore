# ══════════════════════════════════════════════════
#  GOVBRIDGE AI — .gitignore
# ══════════════════════════════════════════════════

# ── Secrets & environment ─────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# ── Node / Frontend ───────────────────────────────
node_modules/
dist/
build/
.vite/
.vercel/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Python / Backend ──────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
.venv/
ENV/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.ruff_cache/
uploads/
*.log

# ── System files ──────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ───────────────────────────────────────────
.vscode/
.idea/
*.swp
