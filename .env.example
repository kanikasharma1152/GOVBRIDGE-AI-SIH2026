# ──────────────────────────────────────────────────
# GOVBRIDGE AI — Environment Variables (Example)
# ──────────────────────────────────────────────────
# Copy this file to .env.local and fill in real values.
# NEVER commit .env or .env.local to git.

# ── Frontend (Vite) ──────────────────────────────
# URL of the deployed Render backend (no trailing slash)
VITE_API_URL=https://govbridge-api.onrender.com

# ── Backend (FastAPI) ────────────────────────────
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=https://govbridge-ai.vercel.app,http://localhost:5175

# Optional: path to local project ZIP for /api/download (leave blank in cloud)
GOVBRIDGE_ZIP_PATH=
